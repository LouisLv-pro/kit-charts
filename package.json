{
  "name": "kit-charts",
  "version": "1.0.0",
  "description": "Bibliothèque de datavisualisation agent-native pour Chart.js, fondée sur les sciences cognitives et WCAG 2.2.",
  "main": "catalog-bundle.js",
  "bin": {
    "kit-charts": "bin/kit-charts.js"
  },
  "files": [
    "bin/",
    "template/",
    "themes/",
    "vendor/",
    ".agents/skills/kit-charts/SKILL.md",
    ".agents/skills/kit-charts/registry.json",
    ".agents/skills/kit-charts/references/",
    ".agents/skills/kit-charts/scripts/",
    ".agents/agents/dataviz.md",
    "catalog-bundle.js",
    "index.html",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node .agents/skills/kit-charts/scripts/build-bundle.js",
    "compile": "node .agents/skills/kit-charts/scripts/compile-chart.js",
    "validate": "node .agents/skills/kit-charts/scripts/validate-chart.js",
    "recommend": "node .agents/skills/kit-charts/scripts/recommend-template.js",
    "lint:chart": "node .agents/skills/kit-charts/scripts/validate-chart.js",
    "lint": "eslint . && stylelint \"**/*.css\" --allow-empty-input",
    "lint:fix": "eslint . --fix && stylelint \"**/*.css\" --fix --allow-empty-input",
    "lint:prune": "eslint . --prune-suppressions",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p jsconfig.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "test": "node test/run-integration-tests.js && node test/workflow-tests.js && node test/snapshot-configs.js --check && node test/token-benchmark.js --assert",
    "snapshots": "node test/snapshot-configs.js",
    "test:render": "node .agents/skills/kit-charts/scripts/render-check.js --all-templates",
    "test:cli": "node test/cli-smoke.js",
    "test:export": "node test/export-tests.js",
    "bench": "node test/token-benchmark.js",
    "vendor": "node .agents/skills/kit-charts/scripts/vendor-fetch.js",
    "make": "node bin/kit-charts.js make"
  },
  "keywords": [
    "dataviz",
    "chartjs",
    "cognitive-science",
    "agent-native",
    "antigravity",
    "wcag",
    "data-visualization",
    "accessibility",
    "tufte",
    "cleveland-mcgill"
  ],
  "author": "kit-charts team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LouisLv-pro/kit-charts.git"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "^6.0.3"
  }
}
