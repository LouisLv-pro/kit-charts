{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tableau Heatmap Matrice 2D",
  "description": "Matrice de concentration avec gradient continu et inversion de contraste WCAG AAA automatique.",
  "type": "object",
  "properties": {
    "targetTemplateId": {
      "type": "string",
      "enum": [
        "table-heatmap-matrix"
      ]
    },
    "layout": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "height": {
          "type": "integer",
          "minimum": 100,
          "maximum": 2000,
          "default": 400
        },
        "footnote": {
          "type": "string",
          "description": "Source ou note de lecture, rendue en pied de carte"
        }
      }
    },
    "colorStrategy": {
      "type": "object",
      "properties": {
        "themeName": {
          "type": "string",
          "enum": [
            "colorbrewer-accessible",
            "viridis-perceptual",
            "paul-tol-scientific",
            "tableau-stone-categorical",
            "okabe-ito-cud",
            "tufte-minimalist-executive",
            "nord-cognitive-dark",
            "atkinson-hyperlegible"
          ],
          "default": "colorbrewer-accessible"
        },
        "mode": {
          "type": "string",
          "enum": [
            "semantic-valence",
            "categorical",
            "sequential",
            "diverging"
          ],
          "default": "categorical"
        },
        "metricPolarity": {
          "type": "string",
          "enum": [
            "HIGHER_IS_BETTER",
            "LOWER_IS_BETTER",
            "TARGET_BASED",
            "NEUTRAL_CATEGORICAL"
          ]
        }
      }
    },
    "cognitiveFeatures": {
      "type": "object",
      "properties": {
        "showDataLabels": {
          "type": "boolean",
          "default": false
        },
        "tooltip": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "antiOcclusion": {
              "type": "boolean",
              "default": true
            }
          }
        }
      }
    },
    "formattedData": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              }
            },
            "required": [
              "label",
              "values"
            ]
          },
          "minItems": 4,
          "maxItems": 24
        },
        "unit": {
          "type": "string"
        }
      },
      "required": [
        "columns",
        "rows"
      ]
    }
  },
  "required": [
    "formattedData"
  ]
}